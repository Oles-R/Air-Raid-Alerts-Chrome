{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "uk",
  "homepage_url": "https://github.com/Oles-R/Ukraine_Alert_Chrome_Ext",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/status-none-16.png",
      "32": "icons/status-none-32.png",
      "48": "icons/status-none-48.png",
      "128": "icons/status-none-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/status-none-16.png",
    "48": "icons/status-none-48.png",
    "128": "icons/status-none-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "tabs",
    "geolocation"
  ],
  "host_permissions": [
    "https://air-raid-alerts-proxy-worker.air-alerts-proxy.workers.dev/*",
    "<all_urls>"
  ]
}
